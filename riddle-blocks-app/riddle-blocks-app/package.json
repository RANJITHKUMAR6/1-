{
  "name": "riddle-blocks",
  "version": "1.0.0",
  "private": true,
  "description": "Riddle Blocks: a timed riddle word game with 200 levels",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node scripts/test.js",
    "android:add": "cap add android",
    "android:assets": "capacitor-assets generate --android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
